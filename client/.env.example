# Copy to .env and fill in values for your environment.
# In development, VITE_GATEWAY_URL can be left empty — Vite proxies /session and /health
# to http://localhost:3000 automatically (see vite.config.ts).

# HTTP gateway base URL. Empty string = relative URLs (dev proxy). Set for production.
VITE_GATEWAY_URL=

# WebSocket gateway URL. Needed explicitly since WS can't use relative URLs.
VITE_WS_GATEWAY_URL=ws://localhost:3000
