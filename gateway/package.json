{
  "name": "hiscribe-gateway",
  "version": "1.0.0",
  "description": "HiScribe Node/TypeScript gateway — WebSocket audio ingest, SSE streaming, REST session management",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --test --require ts-node/register src/__tests__/gladia.test.ts src/__tests__/auth.test.ts src/__tests__/audioStorage.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "@fastify/websocket": "^10.0.0",
    "better-sqlite3": "^9.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
